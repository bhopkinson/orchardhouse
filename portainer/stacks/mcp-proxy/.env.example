DOMAIN=example.com

# Generate with: openssl rand -hex 32
# This is the web UI admin key. MCP clients use a separate mcp_cli_ credential.
MCPPROXY_API_KEY=replace-with-a-random-hex-key

# Subnet of the orchard_proxy network, from:
# docker network inspect orchard_proxy --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
MCPPROXY_TRUSTED_PROXIES=replace-with-orchard-proxy-subnet
